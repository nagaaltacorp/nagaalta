        <mxCell id="title" value="NAAC key performance indicators" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="130" y="8" width="720" height="28" as="geometry"/></mxCell>
<mxCell id="goal" value="&lt;b&gt;Collected sales&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Cash and other non-utang sales, plus utang only after it is paid.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#020617;fontSize=16;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry x="900" y="36" width="560" height="78" as="geometry"/></mxCell>
<mxCell id="cat_sales" value="Sales performance" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1D4ED8;fontColor=#FFFFFF;strokeColor=#1E3A8A;fontSize=15;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="130" y="200" width="430" height="64" as="geometry"/></mxCell>
<mxCell id="cat_inventory" value="Inventory health" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#047857;fontColor=#FFFFFF;strokeColor=#064E3B;fontSize=15;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="680" y="200" width="430" height="64" as="geometry"/></mxCell>
<mxCell id="cat_credit" value="Credit and collections" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C2410C;fontColor=#FFFFFF;strokeColor=#9A3412;fontSize=15;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1230" y="200" width="430" height="64" as="geometry"/></mxCell>
<mxCell id="cat_cashier" value="Cashier control" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7E22CE;fontColor=#FFFFFF;strokeColor=#581C87;fontSize=15;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1780" y="200" width="430" height="64" as="geometry"/></mxCell>
<mxCell id="kpi_sales_0" value="&lt;b&gt;Collected sales&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;Sum of sales.total_price on collected sales. Unpaid utang is excluded until paid_at is set.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;Source: sales&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#1E3A8A;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="130" y="340" width="430" height="112" as="geometry"/></mxCell>
<mxCell id="kpi_sales_1" value="&lt;b&gt;Sales by branch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;Collected sales grouped by the cashier’s branch, for the selected date range.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;Source: sales, users, employees, branches&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#1E3A8A;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="130" y="480" width="430" height="112" as="geometry"/></mxCell>
<mxCell id="kpi_sales_2" value="&lt;b&gt;Top products&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;Units sold per product, ranked. The dashboard pie uses this quantity.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;Source: sales, products&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#1E3A8A;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="130" y="620" width="430" height="112" as="geometry"/></mxCell>
<mxCell id="kpi_sales_3" value="&lt;b&gt;VAT collected&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;Sum of sales.vat_amount on collected sales.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;Source: sales&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#1E3A8A;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="130" y="760" width="430" height="112" as="geometry"/></mxCell>
<mxCell id="kpi_sales_4" value="&lt;b&gt;Discounts given&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;Sum of sales.discount_amount on collected sales.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;Source: sales, discount_options&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#1E3A8A;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="130" y="900" width="430" height="112" as="geometry"/></mxCell>
<mxCell id="kpi_inventory_0" value="&lt;b&gt;On-hand quantity&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;Sum of inventories.quantity. This is the dashboard inventory count.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;Source: inventories&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#064E3B;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="340" width="430" height="112" as="geometry"/></mxCell>
<mxCell id="kpi_inventory_1" value="&lt;b&gt;Low stock&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;Batches whose quantity is at or below settings.low_stock_threshold.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;Source: inventories, settings&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#064E3B;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="480" width="430" height="112" as="geometry"/></mxCell>
<mxCell id="kpi_inventory_2" value="&lt;b&gt;Expected revenue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;Logged as price times quantity when stock is received or adjusted.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;Source: inventory_revenue_logs&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#064E3B;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="620" width="430" height="112" as="geometry"/></mxCell>
<mxCell id="kpi_inventory_3" value="&lt;b&gt;Catalog size&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;Count of products. Branch managers see products stocked in their branch.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;Source: products, inventories&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#064E3B;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="760" width="430" height="112" as="geometry"/></mxCell>
<mxCell id="kpi_inventory_4" value="&lt;b&gt;Retail stock&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;Wholesale quantity plus inventories.retail_remainder for retail sales.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;Source: inventories, products&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#064E3B;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="900" width="430" height="112" as="geometry"/></mxCell>
<mxCell id="kpi_credit_0" value="&lt;b&gt;Unpaid utang&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;payment_method is utang and paid_at is empty.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;Source: sales&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#9A3412;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1230" y="340" width="430" height="112" as="geometry"/></mxCell>
<mxCell id="kpi_credit_1" value="&lt;b&gt;Overdue utang&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;Unpaid utang whose due_date is before today.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;Source: sales&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#9A3412;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1230" y="480" width="430" height="112" as="geometry"/></mxCell>
<mxCell id="kpi_credit_2" value="&lt;b&gt;Collected utang&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;Utang with paid_at set. It then counts as collected sales.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;Source: sales&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#9A3412;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1230" y="620" width="430" height="112" as="geometry"/></mxCell>
<mxCell id="kpi_credit_3" value="&lt;b&gt;Utang exposure&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;Sum of total_price on unpaid utang tickets.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;Source: sales&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#9A3412;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1230" y="760" width="430" height="112" as="geometry"/></mxCell>
<mxCell id="kpi_cashier_0" value="&lt;b&gt;Receipts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;daily_sales_reports.receipt_count for the submitted day.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;Source: daily_sales_reports&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#581C87;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1780" y="340" width="430" height="112" as="geometry"/></mxCell>
<mxCell id="kpi_cashier_1" value="&lt;b&gt;Day sales&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;total_sales, total_vat, and total_discount on the daily report.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;Source: daily_sales_reports&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#581C87;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1780" y="480" width="430" height="112" as="geometry"/></mxCell>
<mxCell id="kpi_cashier_2" value="&lt;b&gt;Cash counted&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;cash_counted entered by the cashier against that day’s sales.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;Source: daily_sales_reports&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#581C87;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1780" y="620" width="430" height="112" as="geometry"/></mxCell>
<mxCell id="kpi_cashier_3" value="&lt;b&gt;Replacement extra&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;Additional amount collected when a product is replaced.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;Source: daily_sales_reports, product_replacements&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#581C87;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1780" y="760" width="430" height="112" as="geometry"/></mxCell>
<mxCell id="kpi_cashier_4" value="&lt;b&gt;Active accounts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#334155&quot;&gt;Users with is_active set. The dashboard also counts total users.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748B&quot;&gt;Source: users&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;fillColor=#FFFFFF;strokeColor=#581C87;fontColor=#0F172A;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1780" y="900" width="430" height="112" as="geometry"/></mxCell>
