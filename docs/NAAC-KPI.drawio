  <diagram id="naac-kpi" name="NAAC KPI">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1244" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
